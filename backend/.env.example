# ============================================
# SMS Pro — Variables d'environnement
# ============================================
# Copiez ce fichier en .env et renseignez vos valeurs.
# Ne commitez JAMAIS le fichier .env sur git.

# App
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sms_marketing

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (générer avec : python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change-me-with-a-secure-random-key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 3MI (LeSMSBUS)
SMSBUS_BASE_URL=https://www.lesmsbus.com:7170/ines.smsbus
SMSBUS_USERNAME=
SMSBUS_PASSWORD=
SMSBUS_ID=
SMSBUS_SENDER_ID=SMSPro

# WhatsApp Business API
WHATSAPP_VERIFY_TOKEN=

# Facebook App (Embedded Signup)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CONFIG_ID=

# AWS
AWS_REGION=eu-west-1
AWS_SQS_QUEUE_URL=
AWS_S3_BUCKET=

# Billing / Orange Money
SUBSCRIPTION_MONTHLY_PRICE=25000
ORANGE_MONEY_MERCHANT_CODE=
ORANGE_MONEY_MERCHANT_NAME=SMS Pro
ORANGE_MONEY_QR_CODE_URL=

# CORS (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
