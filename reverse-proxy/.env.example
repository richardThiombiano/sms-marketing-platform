# ============================================================
# Reverse proxy Traefik — variables d'environnement
# ============================================================
# Copiez en .env :  cp .env.example .env
# NE COMMITEZ JAMAIS .env

# Email utilisé pour les certificats Let's Encrypt
ACME_EMAIL=admin@marikxgroup.com

# Protection Basic Auth du dashboard Traefik.
# Générez la valeur avec :
#   htpasswd -nbB admin 'VOTRE_MOT_DE_PASSE'
# IMPORTANT : dans ce fichier .env, DOUBLEZ chaque $ (remplacez $ par $$)
# car docker-compose interprète les $ comme des variables.
# Exemple (mot de passe = secret) :
#   TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$abcdef......
TRAEFIK_DASHBOARD_AUTH=admin:CHANGEZ_MOI_hash_htpasswd
