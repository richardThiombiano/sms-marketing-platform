# ============================================================
# SMS Marketing Platform — Variables d'environnement PRODUCTION (VPS)
# ============================================================
# Copiez ce fichier en .env.prod puis renseignez vos valeurs :
#     cp .env.prod.example .env.prod
#
# NE COMMITEZ JAMAIS .env.prod (il contient vos secrets).
# Il est lu par docker-compose.prod.yml via --env-file .env.prod
# ============================================================

# ─── Base de données (PostgreSQL conteneurisé) ─────────────────
# Ces valeurs servent à créer la base ET à construire DATABASE_URL
# (assemblée automatiquement dans docker-compose.prod.yml).
POSTGRES_DB=sms_marketing
POSTGRES_USER=postgres
# Générez un mot de passe fort : openssl rand -base64 24
POSTGRES_PASSWORD=CHANGEZ_MOI_mot_de_passe_postgres_fort

# ─── Sous-domaines (routage Traefik) ───────────────────────────
# Sous-domaines exposés par le reverse proxy Traefik.
APP_DOMAIN=app.marikxgroup.com
API_DOMAIN=api.marikxgroup.com

# ─── Application ───────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false

# Nombre de workers uvicorn (≈ nombre de vCPU, min 2)
# VPS actuel : 6 vCore. On garde une marge pour les autres apps.
UVICORN_WORKERS=6

# ─── JWT ───────────────────────────────────────────────────────
# Générez avec : python -c "import secrets; print(secrets.token_hex(32))"
#            ou : openssl rand -hex 32
JWT_SECRET_KEY=CHANGEZ_MOI_cle_jwt_hex_de_64_caracteres
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Frontend (build-time) ─────────────────────────────────────
# URL PUBLIQUE de l'API telle qu'accessible depuis le navigateur.
# Doit inclure le suffixe /v1. Avec le sous-domaine dédié à l'API :
#   https://api.marikxgroup.com/v1
NEXT_PUBLIC_API_URL=https://api.marikxgroup.com/v1

# ─── CORS ──────────────────────────────────────────────────────
# En production, uniquement des origines HTTPS explicites (pas de *).
# Séparez par des virgules. Doit correspondre au domaine du FRONTEND.
ALLOWED_ORIGINS=https://app.marikxgroup.com

# ─── 3MI (LeSMSBUS) — Fournisseur SMS ──────────────────────────
SMSBUS_BASE_URL=https://www.lesmsbus.com:7170/ines.smsbus
SMSBUS_USERNAME=
SMSBUS_PASSWORD=
SMSBUS_ID=
SMSBUS_SENDER_ID=SMSPro
# URL de callback DLR à communiquer à 3MI (adaptez le token)
SMSBUS_DLR_CALLBACK_URL=https://api.marikxgroup.com/v1/webhooks/3mi/dlr?token=CHANGEZ_MOI_token&msg=DLR_STATUS&dnr=numero&msgId=id_du_message
SMSBUS_WEBHOOK_SECRET=CHANGEZ_MOI_token

# ─── WhatsApp Business API (optionnel) ─────────────────────────
WHATSAPP_VERIFY_TOKEN=

# ─── Facebook App (Embedded Signup — optionnel) ────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CONFIG_ID=

# ─── Billing / Orange Money (optionnel) ────────────────────────
SUBSCRIPTION_MONTHLY_PRICE=25000
ORANGE_MONEY_MERCHANT_CODE=
ORANGE_MONEY_MERCHANT_NAME=SMS Pro
ORANGE_MONEY_QR_CODE_URL=

# ─── AWS (optionnel — non requis sur VPS, laisser vide) ────────
AWS_REGION=eu-west-1
AWS_SQS_QUEUE_URL=
AWS_S3_BUCKET=
