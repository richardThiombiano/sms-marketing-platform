{
  "expo": {
    "name": "SMS Pro",
    "slug": "sms-pro-mobile",
    "version": "1.0.0",
    "scheme": "smspro",
    "orientation": "portrait",
//    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
//    "splash": {
//      "image": "./assets/splash.png",
//      "resizeMode": "contain",
//      "backgroundColor": "#4F46E5"
//    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smspro.mobile"
    },
    "android": {
//      "adaptiveIcon": {
//        "foregroundImage": "./assets/adaptive-icon.png",
//        "backgroundColor": "#4F46E5"
//      },
      "package": "com.smspro.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5937b14c-696d-4e30-b404-f298c79a0270"
      }
    }
  }
}
